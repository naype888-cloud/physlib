module

public import PhyslibAlpha.ProbabilisticTheory.HilbertSpace.Dynamics.Hamiltonian
public import PhyslibAlpha.ProbabilisticTheory.HilbertSpace.State.Vector
public import PhyslibAlpha.ProbabilisticTheory.StarAlgebra.Lie
public import PhyslibAlpha.ProbabilisticTheory.StarAlgebra.Statistics

/-!

# Ehrenfest's theorem for vector states

The rate of change of an expectation under a Hamiltonian evolution is the expectation of the
bracket with the Hamiltonian.

## i. Overview

A bounded Hamiltonian `H` evolves an observable `a` in the Heisenberg picture to
`a(t) = U(t)⋆ a U(t)`, which is `α₋ₜ(a)` for the flow `α` of `hamiltonianFlow`. In a vector state
the expectation of `a(t)` is differentiable, and at `t = 0`

  `d/dt ⟨a(t)⟩ = (i/ℏ) ⟨[H, a]⟩ = -(2/ℏ) ⟨⁅H, a⁆⟩`,

where `⁅H, a⁆ = -(i/2) (H a - a H)` is the bracket of observables. Time enters only as the
parameter of the evolution generated by `H`.

## ii. Key results

- `hasDerivAt_ofVec_hamiltonianFlow` : the expectation along the flow is differentiable, with
  derivative the expectation of the commutator with `G`.
- `hasDerivAt_expectation_heisenberg` : Ehrenfest's theorem, `d/dt ⟨a(t)⟩ = -(2/ℏ) ⟨⁅H, a⁆⟩` at
  `t = 0`.

## iii. Table of contents

- A. Expectations along the flow
- B. Ehrenfest's theorem

## iv. References

* P. Ehrenfest, *Bemerkung über die angenäherte Gültigkeit der klassischen Mechanik innerhalb
  der Quantenmechanik*, Z. Phys. 45 (1927) 455–457.

-/

@[expose] public section

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

namespace UnitaryOneParameterGroup

open ProbabilisticTheory
open scoped InnerProductSpace selfAdjoint

/-! ## A. Expectations along the flow -/

/-- The expectation of an operator in a vector state is differentiable along the Hamiltonian
flow, with derivative the expectation of its commutator with `G`. -/
lemma hasDerivAt_ofVec_hamiltonianFlow (ℏ : ℝ) (Hm : Observable (H →L[ℂ] H)) {ψ : H}
    (hψ : ‖ψ‖ = 1) (a : H →L[ℂ] H) (t : ℝ) :
    HasDerivAt (fun s : ℝ => UnitalPositiveLinearMap.ofVec hψ ((hamiltonianFlow ℏ Hm).toFun s a))
      (UnitalPositiveLinearMap.ofVec hψ ⁅(hamiltonianFlow ℏ Hm).toFun t a, G ℏ Hm⁆) t := by
  exact (((innerSL ℂ ψ).comp (ContinuousLinearMap.apply ℂ H ψ)).restrictScalars ℝ).hasFDerivAt
    |>.comp_hasDerivAt t (hasDerivAt_hamiltonianFlow ℏ Hm a t)

/-! ## B. Ehrenfest's theorem -/

/-- **Ehrenfest's theorem.** In the Heisenberg picture `a(t) = α₋ₜ(a)`, the expectation of an
observable changes at `t = 0` at the rate `-(2/ℏ) ⟨⁅H, a⁆⟩`. -/
lemma hasDerivAt_expectation_heisenberg (ℏ : ℝ) (Hm a : Observable (H →L[ℂ] H)) {ψ : H}
    (hψ : ‖ψ‖ = 1) :
    HasDerivAt
      (fun t : ℝ => (UnitalPositiveLinearMap.ofVec hψ ((hamiltonianFlow ℏ Hm).toFun (-t) a)).re)
      (-(2 / ℏ) * (UnitalPositiveLinearMap.ofVec hψ).expectation ⁅Hm, a⁆) 0 := by
  have h := Complex.reCLM.hasFDerivAt.comp_hasDerivAt (0 : ℝ)
    ((hasDerivAt_ofVec_hamiltonianFlow ℏ Hm hψ a (-0)).scomp (0 : ℝ) (hasDerivAt_neg (0 : ℝ)))
  have hE := UnitalPositiveLinearMap.apply_observable_eq_expectation
    (UnitalPositiveLinearMap.ofVec hψ) ⁅Hm, a⁆
  rw [selfAdjoint.coe_bracket, map_smul] at hE
  convert h using 1
  · rfl
  rw [neg_zero, (hamiltonianFlow ℏ Hm).map_zero_apply, Ring.lie_def, G, mul_smul_comm,
    smul_mul_assoc, ← smul_sub, ← neg_sub, smul_neg, map_neg, map_smul]
  rw [map_smul]
  generalize UnitalPositiveLinearMap.ofVec hψ ((Hm : H →L[ℂ] H) * (a : H →L[ℂ] H) -
    (a : H →L[ℂ] H) * (Hm : H →L[ℂ] H)) = X at hE ⊢
  generalize (UnitalPositiveLinearMap.ofVec hψ).expectation ⁅Hm, a⁆ = E at hE ⊢
  rw [smul_eq_mul] at hE ⊢
  have hX : X = 2 * Complex.I * E := by
    linear_combination (2 * Complex.I) * hE + X * Complex.I_sq
  have hc : -(Complex.I / ℏ * (2 * Complex.I * E)) = ((2 / ℏ * E : ℝ) : ℂ) := by
    push_cast
    ring_nf
    rw [Complex.I_sq]
    ring
  rw [hX, smul_eq_mul, hc, Complex.reCLM_apply, Complex.ofReal_re]
  ring

end UnitaryOneParameterGroup
