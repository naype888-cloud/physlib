module

public import PhyslibAlpha.ProbabilisticTheory.StarAlgebra.GNS
public import Physlib.ProbabilisticTheory.State.Basic
public import Mathlib.Algebra.Order.Star.Basic

/-!

# States defined by positivity of `a⋆ a` and states defined by the order

## i. Overview

`AlgState` is defined on a unital `*`-algebra with no order: it is a normalized Hermitian linear
functional with `0 ≤ ω (a⋆ a)`. A state `𝓢[ℂ, A]` is a normalized linear functional that is
monotone for a partial order on `A`. The two definitions are different, and they are only
comparable when the order of `A` is the one generated by the elements `a⋆ a`, that is, when `A` is
a `StarOrderedRing`.

Under that hypothesis, an `AlgState` is monotone, and a monotone normalized functional is
Hermitian and positive on every `a⋆ a`.

## ii. Key results

- `AlgState.toState` : an `AlgState` on a star ordered algebra is a state `𝓢[ℂ, A]`.
- `AlgState.ofState` : a state `𝓢[ℂ, A]` on a star ordered algebra is an `AlgState`.
- `AlgState.ofState_toState`, `AlgState.toState_ofState` : the two maps are inverse.

## iii. Table of contents

- A. From `AlgState` to a monotone functional
- B. From a monotone functional to `AlgState`

## iv. References

-/

@[expose] public section

noncomputable section

namespace ProbabilisticTheory

open scoped ComplexOrder

variable {A : Type*} [Ring A] [Algebra ℂ A] [StarRing A] [StarModule ℂ A]
  [PartialOrder A] [StarOrderedRing A]

/-!

## A. From `AlgState` to a monotone functional

-/

namespace AlgState

omit [PartialOrder A] [StarOrderedRing A] in
/-- An `AlgState` is nonnegative on every element of the cone generated by the `a⋆ a`. -/
lemma nonneg_of_mem_closure (ω : AlgState A) {p : A}
    (hp : p ∈ AddSubmonoid.closure (Set.range fun s : A => star s * s)) : 0 ≤ ω p := by
  induction hp using AddSubmonoid.closure_induction with
  | mem x hx => obtain ⟨s, rfl⟩ := hx; exact ω.nonneg s
  | zero => exact le_of_eq (ω.toLinearMap.map_zero).symm
  | add x y _ _ hx hy => rw [ω.map_add]; exact add_nonneg hx hy

/-- On a star ordered algebra, an `AlgState` is a state `𝓢[ℂ, A]` for the order of `A`. -/
def toState (ω : AlgState A) : 𝓢[ℂ, A] where
  toLinearMap := ω.toLinearMap
  monotone' x y h := by
    obtain ⟨p, hp, rfl⟩ := (StarOrderedRing.le_iff x y).mp h
    have := ω.nonneg_of_mem_closure hp
    change ω x ≤ ω (x + p)
    rw [ω.map_add]
    exact le_add_of_nonneg_right this
  map_one' := ω.map_one

@[simp]
lemma toState_apply (ω : AlgState A) (a : A) : ω.toState a = ω a := rfl

end AlgState

/-!

## B. From a monotone functional to `AlgState`

-/

namespace UnitalPositiveLinearMap

omit [StarModule ℂ A] in
/-- A state `𝓢[ℂ, A]` takes real values on self-adjoint elements, since
`4 x = (x + 1)⋆ (x + 1) - (x - 1)⋆ (x - 1)`. -/
lemma star_apply_of_isSelfAdjoint (φ : 𝓢[ℂ, A]) {x : A} (hx : IsSelfAdjoint x) :
    star (φ x) = φ x := by
  have h4 : (4 : ℂ) • x = star (x + 1) * (x + 1) - star (x - 1) * (x - 1) := by
    simp only [star_add, star_sub, star_one, hx.star_eq, add_mul, mul_add, sub_mul, mul_sub,
      mul_one, one_mul]
    module
  have hp : ∀ s : A, star (φ (star s * s)) = φ (star s * s) := fun s => by
    have : 0 ≤ φ (star s * s) := by
      simpa using φ.monotone (star_mul_self_nonneg s)
    rw [Complex.star_def, Complex.conj_eq_iff_im]
    exact (Complex.nonneg_iff.mp this).2.symm
  have h := congrArg φ h4
  rw [map_sub, map_smul] at h
  have hx' : φ x = (φ (star (x + 1) * (x + 1)) - φ (star (x - 1) * (x - 1))) / 4 := by
    rw [← h]; simp
  rw [hx', star_div₀, star_sub, hp, hp]
  simp

/-- A state `𝓢[ℂ, A]` is Hermitian. -/
lemma map_star_eq (φ : 𝓢[ℂ, A]) (a : A) : φ (star a) = star (φ a) := by
  obtain ⟨h, hh⟩ : ∃ h : A, h = (1 / 2 : ℂ) • (a + star a) := ⟨_, rfl⟩
  obtain ⟨k, hk⟩ : ∃ k : A, k = (-Complex.I / 2) • (a - star a) := ⟨_, rfl⟩
  have hI : Complex.I * (-Complex.I / 2) = 1 / 2 := by
    linear_combination (-1 / 2 : ℂ) * Complex.I_mul_I
  have hhs : IsSelfAdjoint h := by
    show star h = h
    simp only [hh, star_smul, star_add, star_star]
    have : star (1 / 2 : ℂ) = 1 / 2 := by simp
    rw [this]
    module
  have hks : IsSelfAdjoint k := by
    show star k = k
    simp only [hk, star_smul, star_sub, star_star]
    have : star (-Complex.I / 2) = Complex.I / 2 := by simp
    rw [this]
    module
  have ha : a = h + Complex.I • k := by
    rw [hh, hk, smul_smul, hI]
    module
  have hsa : star a = h - Complex.I • k := by
    rw [hh, hk, smul_smul, hI]
    module
  have h1 := star_apply_of_isSelfAdjoint φ hhs
  have h2 := star_apply_of_isSelfAdjoint φ hks
  have e1 : φ a = φ h + Complex.I * φ k := by
    rw [ha, map_add, map_smul, smul_eq_mul]
  have e2 : φ (star a) = φ h - Complex.I * φ k := by
    rw [hsa, map_sub, map_smul, smul_eq_mul]
  rw [e2, e1, star_add, star_mul, h1, h2, Complex.star_def, Complex.conj_I]
  ring

end UnitalPositiveLinearMap

namespace AlgState

/-- On a star ordered algebra, a state `𝓢[ℂ, A]` is an `AlgState`. -/
def ofState (φ : 𝓢[ℂ, A]) : AlgState A where
  toLinearMap := φ.toLinearMap
  map_one' := φ.map_one'
  map_star' a := UnitalPositiveLinearMap.map_star_eq φ a
  nonneg' a := by simpa using φ.monotone (star_mul_self_nonneg a)

@[simp]
lemma ofState_apply (φ : 𝓢[ℂ, A]) (a : A) : ofState φ a = φ a := rfl

@[simp]
lemma ofState_toState (ω : AlgState A) : ofState ω.toState = ω := rfl

@[simp]
lemma toState_ofState (φ : 𝓢[ℂ, A]) : (ofState φ).toState = φ := rfl

end AlgState

end ProbabilisticTheory
